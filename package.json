{
  "name": "indiayatra",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev":       "vite build --watch",
    "build":     "vite build && npm run build:css",
    "build:css": "tailwindcss -i ./src/index.css -o ./dist/assets/css/app.min.css --minify",
    "postbuild": "node scripts/postbuild.js",
    "lint":      "eslint src --ext .js,.jsx"
  },
  "dependencies": {
    "react":     "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer":         "^10.4.19",
    "postcss":              "^8.4.38",
    "tailwindcss":          "^3.4.4",
    "vite":                 "^5.2.12"
  }
}
